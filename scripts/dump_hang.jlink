// =====================================================================
// SM2 Pro — дамп ЗАВИСШЕГО прибора через J-Link OB (Blue Pill).
// Эквивалент scripts/dump_hang.cfg (openocd + ST-Link) для J-Link.
//
// ЗАПУСК (одной строкой, из папки с этим файлом; прибор завис,
// питание ВКЛЮЧЕНО, USB НЕ переткнут):
//
//   "C:\Program Files\SEGGER\JLink\JLink.exe" -device STM32F105VC -if SWD -speed 1000 -AutoConnect 1 -CommanderScript dump_hang.jlink
//
// Если опция -CommanderScript не поддержана (старое ПО J-Link):
// попробуйте -CommandFile dump_hang.jlink, либо запустите JLink.exe
// без параметров, ответьте на вопросы (Device: STM32F105VC, If: SWD,
// Speed: 1000) и введите команды из этого файла руками.
//
// РЕЗУЛЬТАТ: hang_dump_log.txt (весь вывод сессии) + hang_ram.bin
// (полный дамп RAM 64 КБ). ПРИСЛАТЬ ОБА ФАЙЛА.
// =====================================================================

// Писать весь вывод сессии в файл
Log hang_dump_log.txt

// Остановить зависшее ядро, показать регистры: ИСКАТЬ pc / sp / lr
h
regs

// Регистры отказов (CFSR HFSR DFSR MMFAR BFAR AFSR) — если это fault
mem32 0xE000ED28, 6

// Скретч VM-интерпретатора крипто-ядра
mem32 0x20001400, 16

// Таблица VM крипто-ядра (заполняется при входе в 0x0800C15C)
mem32 0x2000D05C, 40

// Окно стека приложения (SP=0x2000FF30, кадр ядра ~1 КБ)
mem32 0x2000F700, 128
mem32 0x2000FA00, 128

// Полный дамп RAM (64 КБ)
savebin hang_ram.bin, 0x20000000, 0x10000

// Закончить (ядро остаётся остановленным — после сохранения файлов
// просто переткните питание прибора)
qc
